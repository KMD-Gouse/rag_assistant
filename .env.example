# Copy this file to .env and add local values. Never commit .env.

# ── Qdrant ───────────────────────────────────────────────────────────────────
# LOCAL (Docker):  QDRANT_URL=http://127.0.0.1:6333  (no API key needed)
# CLOUD:           QDRANT_URL=https://xxxx.us-east.aws.cloud.qdrant.io:6333
#                  QDRANT_API_KEY=<your-qdrant-cloud-api-key>
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=                      # leave blank/unset for local Docker

QDRANT_COLLECTION=annual_report_chunks

# Optional override; default is data/history.sqlite3 under the project root.
# HISTORY_DB_PATH=data/history.sqlite3

# ── Embedding & Reranking models ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Groq (LLM) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=30

# ── RAG pipeline ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=50
RAG_MIN_EVIDENCE_SUFFICIENCY=1.0
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a

# ── Streamlit UI (cloud deployment only) ─────────────────────────────────────
# Set this in Streamlit Cloud's "Secrets" or env vars panel.
# It tells the UI where to reach the deployed FastAPI.
# LOCAL: leave unset (defaults to http://127.0.0.1:8000)
# CLOUD: RAG_API_URL=https://your-fastapi-app.railway.app

