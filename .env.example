# Copy this file to .env and add local values. Never commit .env.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=annual_report_chunks

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=30

# Week 6 generation uses the frozen benchmark-v2 retrieval configuration.
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=50
RAG_MIN_EVIDENCE_SUFFICIENCY=0.70
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a

